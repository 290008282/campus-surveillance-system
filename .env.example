# ============================================
# 智慧园区视频监控系统 - 环境变量配置
# 使用方法: cp .env.example .env 然后修改
# ============================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campus-surveillance-system
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- 后端 ----
JWT_SECRET=campus-secret-key-change-in-production
JWT_EXPIRES_IN=30d
HMAC_KEY=FcQS05HqTFdLJwqKX+JvpF+CmWp+oN6kifSTkSEWr0o=
NODE_ENV=production

# ---- 端口映射 ----
WEB_PORT=8088
API_PORT=3000
RTMP_PORT=1515

# ---- AI 端 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
DETECTION_INTERVAL=0.5
MODEL_DEVICE=cpu

# ---- 系统 ----
TZ=Asia/Shanghai

# ---- 中国大陆镜像加速（部署在国内服务器时取消注释） ----
