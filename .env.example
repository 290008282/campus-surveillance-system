# Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=campus-surveillance-system
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_here_generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=30d

# AI End Configuration
HTTP_SERVER_URL=http://front-backend:3000
RTMP_SERVER_URL=rtmp://front-backend:1515/live
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Application Configuration
NODE_ENV=production
TZ=Asia/Shanghai

# Security Configuration
HMAC_KEY=your_secure_hmac_key_here_generate_with_openssl_rand_base64_32
CORS_ORIGIN=http://192.168.0.254:8088

# Camera Configuration
DETECTION_INTERVAL=0.5
MODEL_DEVICE=cpu